; Version comes from the published tray exe, which gets it from <Version> in Directory.Build.props (C12).
; Override for a manual build: ISCC /DAppVersion=1.10.0 ...
#ifndef AppVersion
  #define AppExePath AddBackslash(SourcePath) + "..\out\tray\NetworkWatchdog.TrayApp.exe"
  #define VerMajor
  #define VerMinor
  #define VerRev
  #define VerBuild
  #define AppVersionFull ParseVersion(AppExePath, VerMajor, VerMinor, VerRev, VerBuild)
  #define AppVersion Str(VerMajor) + "." + Str(VerMinor) + "." + Str(VerRev)
#endif

[Setup]
AppName=Network Watchdog Service
AppVersion={#AppVersion}
VersionInfoVersion={#AppVersion}.0
AppPublisher=Network Watchdog
DefaultDirName={autopf}\NetworkWatchdog
ArchitecturesInstallIn64BitMode=x64
OutputBaseFilename=NetworkWatchdog_Installer
Compression=lzma
SolidCompression=yes
PrivilegesRequired=admin
SetupLogging=yes
DisableProgramGroupPage=yes
CloseApplications=force

[Files]
; Grab everything generated by the publish commands to prevent missing dependency crashes
Source: "..\out\service\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs
Source: "..\out\tray\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs

[InstallDelete]
; Remove the shortcut that older installers created in a folder literally named "(Default)"
Type: files; Name: "{commonprograms}\(Default)\Network Watchdog.lnk"
Type: dirifempty; Name: "{commonprograms}\(Default)"

[Icons]
Name: "{autostartup}\Network Watchdog Tray"; Filename: "{app}\NetworkWatchdog.TrayApp.exe"
Name: "{autoprograms}\Network Watchdog"; Filename: "{app}\NetworkWatchdog.TrayApp.exe"

[Code]
procedure CurStepChanged(CurStep: TSetupStep);
var
  ResultCode: Integer;
begin
  if CurStep = ssInstall then
  begin
    Exec(ExpandConstant('{sys}\taskkill.exe'), '/F /IM NetworkWatchdog.TrayApp.exe', '', SW_HIDE, ewWaitUntilTerminated, ResultCode);
    Exec(ExpandConstant('{sys}\sc.exe'), 'stop NetworkWatchdogService', '', SW_HIDE, ewWaitUntilTerminated, ResultCode);
    Sleep(2000); 
  end;
end;

[Run]
Filename: "{sys}\sc.exe"; Parameters: "create NetworkWatchdogService binPath= ""{app}\NetworkWatchdogService.exe"" start= auto"; Flags: runhidden
Filename: "{sys}\sc.exe"; Parameters: "start NetworkWatchdogService"; Flags: runhidden
Filename: "{app}\NetworkWatchdog.TrayApp.exe"; Description: "Launch NetworkWatchdog Dashboard"; Flags: nowait postinstall runasoriginaluser

[UninstallRun]
Filename: "{sys}\taskkill.exe"; Parameters: "/F /IM NetworkWatchdog.TrayApp.exe"; Flags: runhidden
Filename: "{sys}\sc.exe"; Parameters: "stop NetworkWatchdogService"; Flags: runhidden
Filename: "{sys}\sc.exe"; Parameters: "delete NetworkWatchdogService"; Flags: runhidden